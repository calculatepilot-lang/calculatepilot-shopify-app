{% assign calculator_path = block.settings.calculator_path | strip %}

{% if calculator_path == blank %}
  {% assign calculator_path = app.metafields.calculatepilot.selected_calculator.value | strip %}
{% endif %}

{% assign calculator_title = block.settings.heading | strip %}
{% if calculator_title == blank %}
  {% assign calculator_title = app.metafields.calculatepilot.selected_calculator_name.value | strip %}
{% endif %}
{% if calculator_title == blank %}
  {% assign calculator_title = 'CalculatePilot Calculator' %}
{% endif %}

{% assign calculator_slug = calculator_path | split: '/' | last %}

<div class="calculatepilot-calculator" {{ block.shopify_attributes }}>
  {% if calculator_path != blank %}
    <iframe
      src="https://www.calculatepilot.com/embed/{{ calculator_slug | escape }}.html"
      title="{{ calculator_title | escape }}"
      width="100%"
      height="{{ block.settings.calculator_height }}"
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      style="display:block;width:100%;max-width:100%;border:0;"
    ></iframe>
  {% elsif request.design_mode %}
    <div style="padding:20px;border:1px dashed #cccccc;text-align:center;">
      Choose a calculator in the CalculatePilot app, then add this block again.
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "CalculatePilot Calculator",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Accessible title",
      "info": "Optional. Used by screen readers for the embedded calculator."
    },
    {
      "type": "text",
      "id": "calculator_path",
      "label": "Calculator path",
      "info": "Optional override, for example financial/mortgage-calculator. Leave blank to use the calculator selected in the app."
    },
    {
      "type": "range",
      "id": "calculator_height",
      "label": "Calculator height",
      "min": 300,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 600
    }
  ]
}
{% endschema %}
